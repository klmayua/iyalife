---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export const prerender = false;
---

<BaseLayout title="My Earnings — IyaLife">
  <Nav />
  <main class="max-w-5xl mx-auto px-4 py-8 flex flex-col gap-8">

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-brand-teal-dark">My Earnings</h1>
        <p class="text-brand-muted text-sm mt-0.5">
          You earn every time someone you invited orders.
        </p>
      </div>
      <a href="/account"
        class="text-sm text-brand-muted hover:text-brand-teal transition-colors">
        ← Account
      </a>
    </div>

    <!-- Earnings summary cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {[
        { id:"earn-lifetime", label:"Total earned",  color:"text-brand-gold-dark",  bg:"bg-brand-gold-light",   border:"border-brand-gold/30" },
        { id:"earn-pending",  label:"Pending payout",color:"text-green-700",         bg:"bg-green-50",           border:"border-green-200" },
        { id:"earn-paid",     label:"Paid out",      color:"text-brand-teal",        bg:"bg-brand-teal-light",   border:"border-brand-teal/30" },
        { id:"earn-network",  label:"Network size",  color:"text-brand-ink",         bg:"bg-white",              border:"border-brand-border" },
      ].map(c => (
        <div class={`flex flex-col gap-1 p-4 rounded-brand ${c.bg} border ${c.border}`}>
          <span id={c.id} class={`text-2xl font-bold ${c.color}`}>—</span>
          <span class="text-xs text-brand-muted">{c.label}</span>
        </div>
      ))}
    </div>

    <!-- Tier status + payout info -->
    <div class="rounded-brand bg-white border border-brand-border p-5 flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-brand-teal-dark">Tier & Payout</h2>
        <span id="tier-display"
          class="px-3 py-1 rounded-full text-xs font-semibold border
            bg-gray-100 text-gray-600 border-gray-300">
          ◆ Silver
        </span>
      </div>
      <p class="text-sm text-brand-muted">
        Payouts are processed every Friday to your registered bank account.
        Minimum payout: ₦500.
      </p>
      <div id="bvn-status" class="rounded-md bg-amber-50 border border-amber-200
        px-4 py-2.5 text-xs text-amber-800 hidden">
        Verify your BVN to receive payouts.
        <a href="/account/profile#verify" class="font-semibold underline ml-1">
          Verify now
        </a>
      </div>

      <a id="payout-btn-verify" href="/account/profile#verify"
        class="hidden w-full text-center py-3 rounded-brand bg-brand-surface border
          border-brand-border text-brand-ink font-semibold text-sm hover:border-brand-teal
          transition-colors">
        Verify identity to withdraw
      </a>
      <button id="payout-btn-request"
        class="hidden w-full py-3 rounded-brand bg-brand-teal text-white font-semibold
          text-sm hover:bg-brand-teal-dark transition-colors">
        Request Payout
      </button>
      <p id="payout-message" class="hidden text-xs text-center font-medium"></p>
    </div>

    <!-- Monthly renewal status -->
    <div id="renewal-card" class="rounded-brand border p-5 flex flex-col gap-2">
      <h2 class="font-bold text-brand-teal-dark">Monthly Renewal</h2>
      <p id="renewal-status-text" class="text-sm text-brand-ink"></p>
      <div class="flex items-center gap-4 text-xs text-brand-muted mt-1">
        <span>Last renewal: <span id="renewal-last" class="font-medium text-brand-ink"></span></span>
        <span>Next renewal: <span id="renewal-next" class="font-medium text-brand-ink"></span></span>
      </div>
    </div>

    <!-- Share earnings -->
    <button id="share-earnings-btn"
      class="w-full py-3 rounded-brand bg-brand-gold text-white font-semibold text-sm
        hover:bg-brand-gold-dark transition-colors flex items-center justify-center gap-2">
      Share my earnings
    </button>

    <!-- Referral network table -->
    <div>
      <h2 class="font-bold text-brand-teal-dark mb-4">Your Network</h2>
      <div class="rounded-brand border border-brand-border overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-brand-surface border-b border-brand-border">
            <tr>
              <th class="text-left px-4 py-3 text-xs font-semibold text-brand-muted uppercase tracking-wide">Mother</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-brand-muted uppercase tracking-wide hidden sm:table-cell">Joined</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-brand-muted uppercase tracking-wide">Orders</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-brand-muted uppercase tracking-wide">Earned</th>
            </tr>
          </thead>
          <tbody id="network-table">
            <tr>
              <td colspan="4" class="text-center py-12 text-brand-muted text-sm">
                Your network will appear here as you invite mothers.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Payout history -->
    <div>
      <h2 class="font-bold text-brand-teal-dark mb-4">Payout History</h2>
      <div id="payout-history"
        class="rounded-brand border border-dashed border-brand-border p-8
          text-center text-brand-muted text-sm">
        No payouts yet. Keep building your network!
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const fmt = (n: number) => new Intl.NumberFormat("en-NG",{
    style:"currency",currency:"NGN",minimumFractionDigits:0
  }).format(n);

  async function load() {
    const { data:{user} } = await supabase.auth.getUser();
    if (!user) { window.location.href="/auth/login"; return; }

    const { data: mother } = await supabase
      .from("mothers").select("*").eq("id", user.id).single();
    if (!mother) return;

    document.getElementById("earn-lifetime")!.textContent = fmt(mother.total_earned ?? 0);
    document.getElementById("earn-pending")!.textContent  = fmt(mother.pending_earnings ?? 0);
    document.getElementById("earn-paid")!.textContent     = fmt(mother.paid_out ?? 0);

    // Load referral network
    const { data: referrals } = await supabase
      .from("referrals")
      .select("*, referred:referred_id(full_name, total_orders, created_at)")
      .eq("referrer_id", user.id)
      .order("created_at", { ascending: false });

    document.getElementById("earn-network")!.textContent =
      String(referrals?.length ?? 0);

    if (referrals && referrals.length > 0) {
      const tbody = document.getElementById("network-table")!;
      tbody.innerHTML = referrals.map(r => `
        <tr class="border-b border-brand-border hover:bg-brand-surface transition-colors">
          <td class="px-4 py-3 font-medium text-brand-ink">${r.referred?.full_name ?? "—"}</td>
          <td class="px-4 py-3 text-brand-muted text-xs hidden sm:table-cell">
            ${new Date(r.created_at).toLocaleDateString("en-GB")}
          </td>
          <td class="px-4 py-3 text-right text-brand-ink">${r.referred?.total_orders ?? 0}</td>
          <td class="px-4 py-3 text-right font-semibold text-brand-gold-dark">
            ${fmt(r.commission_total ?? 0)}
          </td>
        </tr>
      `).join("");
    }

    if (!mother.bvn_verified) {
      document.getElementById("bvn-status")!.classList.remove("hidden");
    }

    const tierColors: Record<string,string> = {
      silver:  "bg-gray-100 text-gray-600 border-gray-300",
      gold:    "bg-amber-50 text-amber-700 border-amber-300",
      diamond: "bg-blue-50 text-blue-700 border-blue-300",
    };
    const tier = mother.tier ?? "silver";
    const badge = document.getElementById("tier-display")!;
    badge.className = `px-3 py-1 rounded-full text-xs font-semibold border ${tierColors[tier]}`;
    badge.textContent = `◆ ${tier.charAt(0).toUpperCase()+tier.slice(1)}`;

    // Payout eligibility
    const MIN_PAYOUT = 500;
    const pending = mother.pending_earnings ?? 0;
    if (pending >= MIN_PAYOUT) {
      if (!mother.bvn_verified) {
        document.getElementById("payout-btn-verify")!.classList.remove("hidden");
      } else {
        const btn = document.getElementById("payout-btn-request") as HTMLButtonElement;
        btn.classList.remove("hidden");
        btn.addEventListener("click", async () => {
          btn.disabled = true;
          btn.textContent = "Requesting…";
          const res = await fetch("/api/request-payout", { method: "POST" });
          const body = await res.json();
          const msg = document.getElementById("payout-message")!;
          msg.textContent = res.ok ? body.message : body.error;
          msg.className = `text-xs text-center font-medium ${res.ok ? "text-brand-teal" : "text-red-600"}`;
          msg.classList.remove("hidden");
          if (res.ok) {
            btn.textContent = "Payout requested";
          } else {
            btn.disabled = false;
            btn.textContent = "Request Payout";
          }
        });
      }
    }

    // Monthly renewal status — cycle anchored to signup date, 30 days per cycle
    const createdAt = new Date(mother.created_at);
    const now = new Date();
    const daysSinceJoin = Math.floor((now.getTime() - createdAt.getTime()) / 86400000);
    const cyclesElapsed = Math.max(0, Math.floor(daysSinceJoin / 30));
    const lastRenewal = new Date(createdAt);
    lastRenewal.setDate(lastRenewal.getDate() + cyclesElapsed * 30);
    const nextRenewal = new Date(lastRenewal);
    nextRenewal.setDate(nextRenewal.getDate() + 30);

    const { count: ordersInWindow } = await supabase
      .from("orders").select("id", { count: "exact", head: true })
      .eq("mother_id", user.id).gte("created_at", lastRenewal.toISOString());
    const { count: referralsInWindow } = await supabase
      .from("referrals").select("id", { count: "exact", head: true })
      .eq("referrer_id", user.id).gte("created_at", lastRenewal.toISOString());

    const conditionMet = (ordersInWindow ?? 0) > 0 || (referralsInWindow ?? 0) > 0;
    const daysUntilRenewal = Math.ceil((nextRenewal.getTime() - now.getTime()) / 86400000);

    const dateFmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
    document.getElementById("renewal-last")!.textContent = dateFmt(lastRenewal);
    document.getElementById("renewal-next")!.textContent = dateFmt(nextRenewal);

    const renewalCard  = document.getElementById("renewal-card")!;
    const renewalText  = document.getElementById("renewal-status-text")!;
    if (conditionMet) {
      renewalCard.className = "rounded-brand border border-green-200 bg-green-50 p-5 flex flex-col gap-2";
      renewalText.className = "text-sm text-green-800 font-medium";
      renewalText.textContent = "This month's renewal condition is met. Your 2GB data benefit will renew automatically.";
    } else if (daysUntilRenewal <= 0) {
      renewalCard.className = "rounded-brand border border-red-200 bg-red-50 p-5 flex flex-col gap-2";
      renewalText.className = "text-sm text-red-700 font-medium";
      renewalText.textContent = "Your monthly benefit has lapsed. Place an order or refer a mother to reactivate it.";
    } else {
      renewalCard.className = "rounded-brand border border-amber-200 bg-amber-50 p-5 flex flex-col gap-2";
      renewalText.className = "text-sm text-amber-800 font-medium";
      renewalText.textContent = `${daysUntilRenewal} day${daysUntilRenewal === 1 ? "" : "s"} left to place an order or refer a mother and keep your benefit active.`;
    }

    // Share earnings
    document.getElementById("share-earnings-btn")!.addEventListener("click", () => {
      const link = `${window.location.origin}/join/${mother.referral_code}`;
      const msg = encodeURIComponent(
        `I earned ${fmt(mother.total_earned ?? 0)} this month recommending products to other mothers on IyaLife. You can too. ${link}`
      );
      window.open(`https://wa.me/?text=${msg}`, "_blank");
    });
  }

  load();
</script>
