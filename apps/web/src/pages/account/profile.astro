---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getDemoPersonaKeyFromCookieHeader } from "../../lib/demoPersonas";

export const prerender = false;

const demoPersonaKey = getDemoPersonaKeyFromCookieHeader(Astro.cookies.get("iyalife_demo")?.value);
---
<BaseLayout title="My Profile — IyaLife">
  <Nav />
  {demoPersonaKey && (
    <div class="bg-brand-gold text-white px-4 py-2.5 text-center text-sm font-medium flex items-center justify-center gap-3">
      <span>👋 You're viewing a demo account.</span>
      <a href="/auth/login" onclick="document.cookie='iyalife_demo=; path=/; max-age=0'"
        class="text-white underline decoration-white/50 hover:decoration-white">
        Exit demo
      </a>
    </div>
  )}
  <main class="max-w-2xl mx-auto px-4 py-8 flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-brand-teal-dark">My Profile</h1>
      <a href="/account" class="text-sm text-brand-muted hover:text-brand-teal">← Account</a>
    </div>
    <div id="profile-card" class="rounded-brand border border-brand-border bg-white p-6 flex flex-col gap-5">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-full bg-brand-teal-light flex items-center justify-center text-brand-teal font-bold text-2xl" id="avatar">?</div>
        <div id="profile-name"><p class="font-bold text-brand-teal-dark text-lg">Loading...</p></div>
      </div>
      <div class="grid grid-cols-1 gap-4" id="profile-fields"></div>
      <div id="verify-section" class="hidden rounded-brand bg-amber-50 border border-amber-200 p-4" id="verify">
        <p class="text-sm font-semibold text-amber-800 mb-2">Verify identity to unlock payouts</p>
        <p class="text-xs text-amber-700 mb-3">Your BVN or NIN is required before commission payouts can be processed.</p>
        <button class="px-4 py-2 rounded-md bg-amber-600 text-white text-sm font-semibold hover:bg-amber-700 transition-colors">
          Verify with Paystack
        </button>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script>
  import { supabase } from "../../lib/supabase";
  import { getDemoPersonaKeyFromClient, DEMO_PERSONAS } from "../../lib/demoPersonas";

  async function load() {
    const demoKey = getDemoPersonaKeyFromClient();
    let m;

    if (demoKey) {
      m = DEMO_PERSONAS[demoKey];
    } else {
      const { data:{user} } = await supabase.auth.getUser();
      if (!user) { window.location.href="/auth/login"; return; }
      const { data: fetched } = await supabase.from("mothers").select("*").eq("id",user.id).single();
      m = fetched;
    }

    if (!m) return;
    document.getElementById("avatar")!.textContent = m.full_name.charAt(0);
    document.getElementById("profile-name")!.innerHTML = `<p class="font-bold text-brand-teal-dark text-lg">${m.full_name}</p><p class="text-sm text-brand-muted">Member #${m.member_number ?? "—"}</p>`;
    const fields = [
      {label:"Phone", value:m.phone},
      {label:"Email", value:m.email ?? "Not set"},
      {label:"Tier", value:`◆ ${m.tier ? m.tier.charAt(0).toUpperCase()+m.tier.slice(1) : "Silver"}`},
      {label:"Joined", value:new Date(m.created_at).toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"})},
      {label:"Journey stage", value:m.journey_stage ?? "—"},
    ];
    document.getElementById("profile-fields")!.innerHTML = fields.map(f =>
      `<div class="flex justify-between items-center py-2 border-b border-brand-border last:border-0">
        <span class="text-sm text-brand-muted">${f.label}</span>
        <span class="text-sm font-medium text-brand-ink">${f.value}</span>
      </div>`
    ).join("");
    if (!m.bvn_verified) document.getElementById("verify-section")!.classList.remove("hidden");
  }
  load();
</script>
