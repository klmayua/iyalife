---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export const prerender = false;
---
<BaseLayout title="Cart — IyaLife">
  <Nav />
  <main class="max-w-5xl mx-auto px-4 py-8 flex flex-col gap-6">
    <h1 class="text-2xl font-bold text-brand-teal-dark">Your Cart</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Items -->
      <div class="md:col-span-2 flex flex-col gap-4" id="cart-items">
        <div class="rounded-brand border border-dashed border-brand-border p-12 text-center text-brand-muted text-sm">
          Your cart is empty. <a href="/shop" class="text-brand-teal font-medium">Start shopping</a>
        </div>
      </div>

      <!-- Summary -->
      <div class="flex flex-col gap-4">
        <div class="rounded-brand border border-brand-border bg-white p-5 flex flex-col gap-4 sticky top-20">
          <h2 class="font-bold text-brand-teal-dark">Order Summary</h2>
          <div class="flex flex-col gap-2 text-sm">
            <div class="flex justify-between text-brand-muted">
              <span>Subtotal</span>
              <span id="subtotal">₦0</span>
            </div>
            <div class="flex justify-between text-brand-muted">
              <span>Delivery</span>
              <span class="text-green-600 font-medium">Calculated at checkout</span>
            </div>
            <div class="border-t border-brand-border pt-2 flex justify-between font-bold text-brand-ink">
              <span>Total</span>
              <span id="total" class="text-brand-teal">₦0</span>
            </div>
          </div>
          <a href="/checkout"
            id="checkout-btn"
            class="w-full py-3 rounded-brand bg-brand-teal text-white font-semibold
              text-sm text-center hover:bg-brand-teal-dark transition-colors shadow-brand">
            Proceed to checkout
          </a>
          <a href="/shop" class="text-xs text-brand-muted text-center hover:text-brand-teal transition-colors">
            Continue shopping
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { cartItems, cartTotal, removeFromCart, updateQuantity, formatPrice } from "../../stores/cart";

  declare global {
    interface Window {
      changeQty: (id: string, qty: number) => void;
      removeItem: (id: string) => void;
    }
  }

  function render() {
    const items = cartItems.get();
    const total = cartTotal.get();
    const el    = document.getElementById("cart-items")!;

    document.getElementById("subtotal")!.textContent = formatPrice(total);
    document.getElementById("total")!.textContent    = formatPrice(total);

    if (items.length === 0) {
      el.innerHTML = `<div class="rounded-brand border border-dashed border-brand-border p-12 text-center text-brand-muted text-sm">Your cart is empty. <a href="/shop" class="text-brand-teal font-medium">Start shopping</a></div>`;
      return;
    }

    el.innerHTML = items.map(item => `
      <div class="rounded-brand border border-brand-border bg-white p-4 flex gap-4 items-center">
        <div class="w-16 h-16 rounded-md bg-brand-surface flex items-center justify-center text-2xl flex-shrink-0">
          ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover rounded-md"/>` : "🛒"}
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-brand-ink text-sm line-clamp-1">${item.name}</p>
          <p class="text-brand-teal font-bold mt-0.5">${formatPrice(item.price)}</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="changeQty('${item.id}', ${item.quantity - 1})"
            class="w-7 h-7 rounded-md border border-brand-border flex items-center justify-center text-brand-muted hover:border-brand-teal hover:text-brand-teal transition-colors text-sm">−</button>
          <span class="w-6 text-center text-sm font-semibold">${item.quantity}</span>
          <button onclick="changeQty('${item.id}', ${item.quantity + 1})"
            class="w-7 h-7 rounded-md border border-brand-border flex items-center justify-center text-brand-muted hover:border-brand-teal hover:text-brand-teal transition-colors text-sm">+</button>
          <button onclick="removeItem('${item.id}')"
            class="ml-2 text-xs text-red-400 hover:text-red-600 transition-colors">Remove</button>
        </div>
      </div>
    `).join("");
  }

  window.changeQty   = (id: string, qty: number) => { updateQuantity(id, qty); render(); };
  window.removeItem  = (id: string) => { removeFromCart(id); render(); };

  cartItems.subscribe(() => render());
  render();
</script>
