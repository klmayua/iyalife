---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---
<BaseLayout title="Earn with IyaLife">
  <Nav />
  <main class="flex flex-col">

    <section class="bg-gradient-to-br from-brand-gold-dark via-brand-gold to-brand-gold/70 text-white px-4 py-16 text-center">
      <div class="max-w-2xl mx-auto flex flex-col gap-5">
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">
          Turn trust into income.
        </h1>
        <p class="text-white/80 text-lg leading-relaxed">
          You already recommend products to other mothers every day.
          IyaLife pays you for it — permanently, from every order they make.
        </p>
        <a href="/account/earnings"
          class="self-center px-8 py-3.5 rounded-brand bg-white text-brand-gold-dark
            font-semibold hover:bg-brand-surface transition-colors shadow-gold">
          See your earnings dashboard
        </a>
      </div>
    </section>

    <section class="bg-white px-4 py-14">
      <div class="max-w-4xl mx-auto flex flex-col gap-10">
        <h2 class="text-2xl font-bold text-brand-teal-dark text-center">How it works</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div class="flex flex-col gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center text-white font-bold text-lg">1</div>
            <h3 class="font-bold text-brand-teal-dark">Invite a mother</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Share your personal IyaLife link with someone you trust. She receives an invitation — not a sales pitch.</p>
          </div>
          <div class="flex flex-col gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center text-white font-bold text-lg">2</div>
            <h3 class="font-bold text-brand-teal-dark">She joins and shops</h3>
            <p class="text-brand-muted text-sm leading-relaxed">When she joins and makes her first order, your earnings begin. You see it in real time.</p>
          </div>
          <div class="flex flex-col gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center text-white font-bold text-lg">3</div>
            <h3 class="font-bold text-brand-teal-dark">You earn — every time</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Every order she makes, permanently, earns you a commission. It compounds as your network grows.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-surface px-4 py-14">
      <div class="max-w-4xl mx-auto flex flex-col gap-8">
        <h2 class="text-2xl font-bold text-brand-teal-dark text-center">
          The Precious Elements — Your Tier Journey
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-brand border border-gray-300 bg-gray-100 flex flex-col gap-3">
            <span class="text-2xl text-gray-600">◆</span>
            <h3 class="font-bold text-lg text-gray-700">Silver</h3>
            <p class="text-sm text-brand-muted">Start earning. Your first referral activates your commission. Direct earnings on every order.</p>
          </div>
          <div class="p-5 rounded-brand border border-amber-300 bg-amber-50 flex flex-col gap-3">
            <span class="text-2xl text-amber-700">◆</span>
            <h3 class="font-bold text-lg text-amber-700">Gold</h3>
            <p class="text-sm text-brand-muted">Established earner. Uplift on commission rates. Secondary network earnings unlock.</p>
          </div>
          <div class="p-5 rounded-brand border border-blue-300 bg-blue-50 flex flex-col gap-3">
            <span class="text-2xl text-blue-700">◆</span>
            <h3 class="font-bold text-lg text-blue-700">Diamond</h3>
            <p class="text-sm text-brand-muted">Community anchor. Maximum rates. Your network earns for you while you sleep.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-teal-dark text-white px-4 py-14 text-center">
      <div class="max-w-2xl mx-auto flex flex-col gap-5">
        <h2 class="text-2xl font-bold">Your earnings are waiting.</h2>
        <p class="text-white/70">Members-only. If you have an account, your dashboard is live.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/account/earnings"
            class="px-6 py-3.5 rounded-brand bg-brand-gold text-white font-semibold hover:bg-brand-gold-dark transition-colors">
            My earnings dashboard
          </a>
          <a href="/account"
            class="px-6 py-3.5 rounded-brand bg-white/10 border border-white/30 text-white font-semibold hover:bg-white/20 transition-colors">
            My account
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
