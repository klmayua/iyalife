---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getProducts, getProductCategoryCounts } from "../../lib/supabase";

const selectedCategory = Astro.url.searchParams.get("category") ?? "";
const products = await getProducts(selectedCategory || undefined, 24);
const categoryCounts = await getProductCategoryCounts();
const totalCount = Object.values(categoryCounts).reduce((sum, n) => sum + n, 0);

const categories = [
  { id: "",                  label: "All Products",       emoji: "✨" },
  { id: "baby-care",         label: "Baby & Infant Care", emoji: "👶" },
  { id: "maternal-health",   label: "Maternal Health",    emoji: "🌿" },
  { id: "household",         label: "Household Essentials",emoji: "🏠" },
  { id: "child-development", label: "Child Development",  emoji: "📚" },
];

const categoryLabels: Record<string,string> = {
  "baby-care":         "Baby & Infant Care",
  "maternal-health":   "Maternal Health",
  "household":         "Household Essentials",
  "child-development": "Child Development",
};
const selectedLabel = selectedCategory
  ? (categoryLabels[selectedCategory] ?? selectedCategory)
  : "";
---

<BaseLayout title="Shop — IyaLife">
  <Nav />

  <main class="max-w-5xl mx-auto px-4 py-8 flex flex-col gap-8">

    <!-- Header -->
    <div>
      <h1 class="text-2xl font-bold text-brand-teal-dark">Shop</h1>
      <p class="text-brand-muted text-sm mt-1">
        Curated for mothers. Trusted before it reaches you.
      </p>
    </div>

    <!-- Search -->
    <div class="relative">
      <input
        id="product-search"
        type="search"
        placeholder="Search products..."
        class="w-full px-3.5 py-2.5 rounded-brand border border-brand-border
          text-brand-ink placeholder:text-brand-muted/50 text-sm bg-white
          focus:outline-none focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20"
      />
    </div>

    <!-- Category filter -->
    <div class="flex gap-2 overflow-x-auto pb-1 -mx-4 px-4 scrollbar-none">
      {categories.map(cat => {
        const count = cat.id ? (categoryCounts[cat.id] ?? 0) : totalCount;
        return (
          <a
            href={cat.id ? `/shop?category=${cat.id}` : "/shop"}
            class={`flex-shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full
              text-sm font-medium border transition-all
              ${(selectedCategory === cat.id || (!selectedCategory && !cat.id))
                ? "bg-brand-teal text-white border-brand-teal"
                : "bg-white text-brand-muted border-brand-border hover:border-brand-teal hover:text-brand-teal"
              }`}>
            <span>{cat.emoji}</span>
            <span>{cat.label}</span>
            <span class="opacity-70">[{count}]</span>
          </a>
        );
      })}
    </div>

    <!-- Products grid -->
    {products.length > 0 ? (
      <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {products.map(p => (
          <div class="product-item" data-name={p.name.toLowerCase()}>
            <ProductCard
              id={p.id}
              name={p.name}
              price={p.price}
              image={p.image}
              category={p.category}
              slug={p.slug}
              badge={p.is_founding_deal ? "Founding Deal" : undefined}
            />
          </div>
        ))}
      </div>
      <p id="search-empty" class="hidden text-center text-brand-muted text-sm py-8">
        No products match your search.
      </p>
    ) : (
      <div class="rounded-brand border border-dashed border-brand-border
        py-16 px-6 text-center flex flex-col gap-3 items-center">
        <div class="text-4xl">🌿</div>
        <p class="text-brand-muted text-sm">
          {selectedLabel ? `${selectedLabel} products are coming soon.` : "Products coming soon."}
        </p>
        <p class="text-brand-muted text-xs max-w-xs">
          Be the first to know when they land — leave your email and we'll notify you.
        </p>
        <form id="notify-form" class="flex gap-2 w-full max-w-xs mt-1" data-category={selectedCategory}>
          <input
            id="notify-email"
            type="email"
            required
            placeholder="you@example.com"
            class="flex-1 px-3 py-2 rounded-brand border border-brand-border text-sm
              text-brand-ink placeholder:text-brand-muted/50
              focus:outline-none focus:border-brand-teal"
          />
          <button type="submit"
            class="px-4 py-2 rounded-brand bg-brand-teal text-white text-sm font-semibold
              hover:bg-brand-teal-dark transition-colors flex-shrink-0">
            Notify me
          </button>
        </form>
        <p id="notify-confirm" class="hidden text-xs text-brand-teal font-medium">
          Thanks — we'll let you know.
        </p>
        <a href="/shop"
          class="text-sm text-brand-teal font-medium hover:underline mt-1">
          Browse all products
        </a>
      </div>
    )}

    <!-- Trust signal -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {[
        { icon:"🔒", label:"Trusted products only", sub:"Every item vetted before it reaches you." },
        { icon:"🚚", label:"Reliable delivery",     sub:"Partnered with trusted fulfilment networks." },
        { icon:"💛", label:"Earn as you shop",      sub:"Refer a friend and earn from their orders." },
      ].map(t => (
        <div class="flex items-start gap-3 p-4 rounded-brand bg-brand-surface
          border border-brand-border">
          <span class="text-xl">{t.icon}</span>
          <div>
            <p class="text-sm font-semibold text-brand-ink">{t.label}</p>
            <p class="text-xs text-brand-muted mt-0.5">{t.sub}</p>
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>(".product-item"));
  const emptyState = document.getElementById("search-empty");

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;
    items.forEach((el) => {
      const match = !q || (el.dataset.name ?? "").includes(q);
      el.classList.toggle("hidden", !match);
      if (match) visibleCount++;
    });
    if (emptyState) emptyState.classList.toggle("hidden", visibleCount !== 0 || items.length === 0);
  });

  const notifyForm = document.getElementById("notify-form") as HTMLFormElement | null;
  notifyForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const { supabase } = await import("../../lib/supabase");
    const emailInput = document.getElementById("notify-email") as HTMLInputElement;
    const email = emailInput.value.trim();
    if (!email) return;

    await supabase.from("waitlist_emails").insert({
      email,
      category: notifyForm.dataset.category || null,
    });

    notifyForm.classList.add("hidden");
    document.getElementById("notify-confirm")?.classList.remove("hidden");
  });
</script>
