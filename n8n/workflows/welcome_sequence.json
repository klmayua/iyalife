{
  "name": "IyaLife — Founding Mother Welcome Sequence",
  "nodes": [
    {
      "id": "trigger-webhook",
      "name": "Trigger: Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "path": "welcome",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "notes": "Input: { user_id, phone, full_name, referrer_name, member_number }"
    },
    {
      "id": "send-welcome-letter",
      "name": "Send Welcome Letter (0s)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"founding_welcome_letter\",\n    \"language\": { \"code\": \"en\" },\n    \"components\": [{\n      \"type\": \"body\",\n      \"parameters\": [\n        { \"type\": \"text\", \"text\": $json.full_name },\n        { \"type\": \"text\", \"text\": $json.referrer_name },\n        { \"type\": \"text\", \"text\": String($json.member_number) }\n      ]\n    }]\n  }\n} }}"
      }
    },
    {
      "id": "wait-60s",
      "name": "Wait 60s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [520, 0],
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "trigger-data-bundle",
      "name": "Trigger Data Bundle Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.africastalking.com/version1/data",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apiKey", "value": "[AFRICA_TALKING_KEY]" },
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"phoneNumber\": $json.phone, \"bundle\": \"2GB-30days\" } }}",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 600000,
      "onError": "continueRegularOutput",
      "notes": "Retries 3x at 10-minute intervals. On final failure, falls through to the WhatsApp fallback branch below."
    },
    {
      "id": "if-bundle-delivered",
      "name": "If: Bundle Delivered",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1040, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-bundle-fallback",
      "name": "Send Data Bundle Fallback (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 220],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"data_bundle_delayed\",\n    \"language\": { \"code\": \"en\" }\n  }\n} }}"
      },
      "notes": "Fires only when the 3 automatic retries against Africa's Talking all fail."
    },
    {
      "id": "wait-120s",
      "name": "Wait 120s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1300, 0],
      "parameters": {
        "amount": 120,
        "unit": "seconds"
      }
    },
    {
      "id": "send-founding-badge",
      "name": "Send Founding Member Badge (120s)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 0],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $json.phone,\n  \"type\": \"image\",\n  \"image\": {\n    \"link\": \"https://iyalife.com/badges/founding-member.png\",\n    \"caption\": \"Founding Member #\" + $json.member_number + \" of 1,000. Welcome to IyaLife, \" + $json.full_name + \".\"\n  }\n} }}"
      }
    },
    {
      "id": "wait-180s",
      "name": "Wait 180s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1820, 0],
      "parameters": {
        "amount": 180,
        "unit": "seconds"
      }
    },
    {
      "id": "fetch-coupon",
      "name": "Fetch First-Purchase Coupon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 0],
      "parameters": {
        "method": "GET",
        "url": "=[SUPABASE_URL]/rest/v1/coupons?mother_id=eq.{{ $('Trigger: Webhook').item.json.user_id }}&used=eq.false&select=code,discount_pct",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "[SUPABASE_SERVICE_KEY]" },
            { "name": "Authorization", "value": "Bearer [SUPABASE_SERVICE_KEY]" }
          ]
        }
      }
    },
    {
      "id": "send-coupon",
      "name": "Send Coupon Code (180s)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 0],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $('Trigger: Webhook').item.json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"first_purchase_deal\",\n    \"language\": { \"code\": \"en\" },\n    \"components\": [{\n      \"type\": \"body\",\n      \"parameters\": [{ \"type\": \"text\", \"text\": $json[0]?.code ?? \"\" }]\n    }]\n  }\n} }}"
      }
    },
    {
      "id": "wait-3d",
      "name": "Wait 3 days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2600, 0],
      "parameters": {
        "amount": 3,
        "unit": "days"
      }
    },
    {
      "id": "send-health-line",
      "name": "Send Health Line Intro (Day 3)",
