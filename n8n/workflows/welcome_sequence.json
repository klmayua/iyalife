      "typeVersion": 4.2,
      "position": [2860, 0],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $('Trigger: Webhook').item.json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"health_line_intro\",\n    \"language\": { \"code\": \"en\" }\n  }\n} }}"
      }
    },
    {
      "id": "wait-7d",
      "name": "Wait 7 days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [3120, 0],
      "parameters": {
        "amount": 7,
        "unit": "days"
      }
    },
    {
      "id": "send-uradi-unlock",
      "name": "Send Uradi Access Unlock (Day 7)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3380, 0],
      "parameters": {
