        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $('Trigger: Webhook').item.json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"uradi_access_unlocked\",\n    \"language\": { \"code\": \"en\" }\n  }\n} }}"
      }
    },
    {
      "id": "wait-14d",
      "name": "Wait 14 days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [3640, 0],
      "parameters": {
        "amount": 14,
        "unit": "days"
      }
    },
    {
      "id": "check-first-purchase",
      "name": "Check First Purchase (Day 14)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3900, 0],
      "parameters": {
        "method": "GET",
        "url": "=[SUPABASE_URL]/rest/v1/orders?mother_id=eq.{{ $('Trigger: Webhook').item.json.user_id }}&select=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "[SUPABASE_SERVICE_KEY]" },
            { "name": "Authorization", "value": "Bearer [SUPABASE_SERVICE_KEY]" }
          ]
        }
      }
    },
    {
      "id": "if-no-purchase",
      "name": "If: No Purchase Yet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [4160, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-reengagement",
      "name": "Send Re-engagement + Coupon Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4420, 0],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/[WHATSAPP_PHONE_ID]/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [WHATSAPP_TOKEN]" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $('Trigger: Webhook').item.json.phone,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"reengagement_coupon_reminder\",\n    \"language\": { \"code\": \"en\" }\n  }\n} }}"
      }
    }
  ],
